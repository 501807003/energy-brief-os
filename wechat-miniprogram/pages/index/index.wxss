.home {
  padding-top: 18rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.topbar button {
  min-width: 112rpx;
  height: 48rpx;
  border-radius: 999rpx;
  color: #0071e3;
  background: #fff;
  font-size: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, .06);
}

.hero {
  padding: 52rpx 0 40rpx;
}

.eyebrow {
  display: block;
  color: #6e6e73;
  font-size: 26rpx;
  font-weight: 650;
  text-align: center;
}

.title {
  display: grid;
  gap: 0;
  margin-top: 18rpx;
  text-align: center;
  font-size: 78rpx;
  font-weight: 850;
  line-height: 1;
  letter-spacing: 0;
}

.summary {
  display: block;
  margin: 24rpx auto 0;
  max-width: 650rpx;
  color: #6e6e73;
  font-size: 29rpx;
  line-height: 1.45;
  text-align: center;
}

.glass-panel,
.price-card,
.learn-card {
  border-radius: 44rpx;
  background: #fff;
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, .08);
}

.glass-panel {
  padding: 32rpx;
  background:
    radial-gradient(circle at 100% 0, rgba(0, 113, 227, .12), transparent 38%),
    linear-gradient(180deg, #ffffff, #f1f7ff);
}

.panel-kicker {
  display: block;
  color: #0071e3;
  font-size: 23rpx;
  font-weight: 820;
}

.panel-title {
  display: block;
  margin-top: 12rpx;
  font-size: 46rpx;
  font-weight: 820;
  line-height: 1.12;
}

.panel-sub {
  display: block;
  margin-top: 14rpx;
  color: #6e6e73;
  font-size: 26rpx;
  line-height: 1.5;
}

.section-list {
  display: grid;
  gap: 16rpx;
  margin-top: 28rpx;
}

.section-row {
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr) 28rpx;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 156rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, .9);
  text-align: left;
  box-shadow: 0 14rpx 42rpx rgba(0, 0, 0, .045);
}

.row-index-wrap {
  display: grid;
  gap: 8rpx;
  justify-items: start;
}

.row-index {
  color: #0071e3;
  font-size: 27rpx;
  font-weight: 800;
}

.row-label {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #006edb;
  background: #eaf3ff;
  font-size: 21rpx;
  font-weight: 720;
}

.row-content {
  min-width: 0;
}

.row-title,
.row-desc {
  display: block;
}

.row-title {
  font-size: 32rpx;
  font-weight: 760;
  line-height: 1.25;
}

.row-desc {
  margin-top: 10rpx;
  color: #6e6e73;
  font-size: 25rpx;
  line-height: 1.45;
}

.row-arrow {
  color: #9a9aa0;
  font-size: 44rpx;
  line-height: 1;
  text-align: right;
}

.price-card,
.learn-card {
  margin-top: 26rpx;
  padding: 34rpx;
}

.block-label {
  display: block;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 760;
}

.price-row {
  margin-top: 26rpx;
}

.price-head {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 650;
}

.track {
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #e2e6ec;
}

.bar {
  height: 100%;
  border-radius: inherit;
  background: #0071e3;
}

.learn-card {
  color: #fff;
  background: #111114;
}

.learn-card .block-label {
  color: rgba(255, 255, 255, .56);
}

.learn-title {
  display: block;
  margin-top: 24rpx;
  font-size: 46rpx;
  font-weight: 820;
}

.learn-copy {
  display: block;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, .74);
  font-size: 28rpx;
  line-height: 1.65;
}
