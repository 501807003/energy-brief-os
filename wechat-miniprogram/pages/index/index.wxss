.home {
  padding-top: 22rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.topbar button {
  min-width: 112rpx;
  height: 48rpx;
  border-radius: 999rpx;
  color: #0071e3;
  background: #fff;
  font-size: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, .06);
}

.hero {
  padding: 72rpx 0 54rpx;
}

.eyebrow {
  display: block;
  color: #6e6e73;
  font-size: 26rpx;
  font-weight: 650;
  text-align: center;
}

.title {
  display: grid;
  gap: 0;
  margin-top: 22rpx;
  text-align: center;
  font-size: 88rpx;
  font-weight: 850;
  line-height: .98;
  letter-spacing: 0;
}

.summary {
  display: block;
  margin: 32rpx auto 0;
  max-width: 650rpx;
  color: #6e6e73;
  font-size: 32rpx;
  line-height: 1.45;
  text-align: center;
}

.glass-panel,
.price-card,
.learn-card {
  border-radius: 44rpx;
  background: #fff;
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, .08);
}

.glass-panel {
  padding: 34rpx;
  background: linear-gradient(180deg, #ffffff, #eef5ff);
}

.panel-title {
  display: block;
  font-size: 42rpx;
  font-weight: 820;
  line-height: 1.12;
}

.panel-sub {
  display: block;
  margin-top: 14rpx;
  color: #6e6e73;
  font-size: 26rpx;
  line-height: 1.5;
}

.section-list {
  display: grid;
  gap: 18rpx;
  margin-top: 30rpx;
}

.section-row {
  display: grid;
  grid-template-columns: 68rpx 1fr;
  gap: 18rpx;
  width: 100%;
  min-height: 138rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .82);
  text-align: left;
}

.row-index {
  color: #0071e3;
  font-size: 24rpx;
  font-weight: 800;
  padding-top: 4rpx;
}

.row-title,
.row-desc {
  display: block;
}

.row-title {
  font-size: 30rpx;
  font-weight: 760;
  line-height: 1.25;
}

.row-desc {
  margin-top: 10rpx;
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.45;
}

.price-card,
.learn-card {
  margin-top: 26rpx;
  padding: 34rpx;
}

.block-label {
  display: block;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 760;
}

.price-row {
  margin-top: 26rpx;
}

.price-head {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 650;
}

.track {
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #e2e6ec;
}

.bar {
  height: 100%;
  border-radius: inherit;
  background: #0071e3;
}

.learn-card {
  color: #fff;
  background: #111114;
}

.learn-card .block-label {
  color: rgba(255, 255, 255, .56);
}

.learn-title {
  display: block;
  margin-top: 24rpx;
  font-size: 46rpx;
  font-weight: 820;
}

.learn-copy {
  display: block;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, .74);
  font-size: 28rpx;
  line-height: 1.65;
}
