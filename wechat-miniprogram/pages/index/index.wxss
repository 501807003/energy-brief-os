.home {
  padding-top: 18rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 68rpx;
}

.brand,
.date-line {
  display: block;
}

.brand {
  font-size: 28rpx;
  font-weight: 780;
}

.date-line {
  margin-top: 6rpx;
  color: #8f8f95;
  font-size: 22rpx;
  font-weight: 600;
}

.archive-link {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 72rpx;
  height: 44rpx;
  margin-left: auto;
  padding: 0 4rpx;
  border-radius: 0;
  color: #0071e3;
  background: transparent;
  font-size: 25rpx;
  font-weight: 700;
  text-align: right;
}

.hero {
  padding: 48rpx 0 40rpx;
}

.title {
  display: grid;
  gap: 0;
  margin-top: 18rpx;
  text-align: center;
  font-size: 78rpx;
  font-weight: 850;
  line-height: 1;
  letter-spacing: 0;
}

.summary {
  display: block;
  margin: 24rpx auto 0;
  max-width: 650rpx;
  color: #6e6e73;
  font-size: 29rpx;
  line-height: 1.45;
  text-align: center;
}

.focus-panel,
.price-card,
.learn-card {
  border-radius: 44rpx;
  background: #fff;
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, .08);
}

.focus-panel {
  padding: 32rpx 0 34rpx 32rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 100% 0, rgba(0, 113, 227, .12), transparent 38%),
    linear-gradient(180deg, #ffffff, #f1f7ff);
}

.panel-head {
  padding-right: 32rpx;
}

.panel-kicker {
  display: block;
  color: #0071e3;
  font-size: 23rpx;
  font-weight: 820;
}

.panel-title {
  display: block;
  margin-top: 12rpx;
  font-size: 46rpx;
  font-weight: 820;
  line-height: 1.12;
}

.panel-sub {
  display: block;
  margin-top: 14rpx;
  color: #6e6e73;
  font-size: 26rpx;
  line-height: 1.5;
}

.focus-scroll {
  width: 100%;
  margin-top: 30rpx;
  white-space: nowrap;
}

.focus-track {
  display: inline-flex;
  gap: 20rpx;
  padding-right: 32rpx;
}

.focus-card {
  display: flex;
  flex-direction: column;
  width: 456rpx;
  min-height: 330rpx;
  padding: 30rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, .94);
  text-align: left;
  white-space: normal;
  box-shadow: 0 18rpx 52rpx rgba(0, 0, 0, .065);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.card-index {
  display: block;
  color: #0071e3;
  font-size: 30rpx;
  font-weight: 800;
}

.card-label {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #006edb;
  background: #eaf3ff;
  font-size: 22rpx;
  font-weight: 720;
}

.card-arrow {
  color: #9a9aa0;
  font-size: 48rpx;
  line-height: 1;
}

.card-title,
.card-desc {
  display: block;
}

.card-title {
  margin-top: 34rpx;
  font-size: 38rpx;
  font-weight: 820;
  line-height: 1.14;
}

.card-desc {
  margin-top: 22rpx;
  color: #6e6e73;
  font-size: 27rpx;
  line-height: 1.52;
}

.price-card,
.learn-card {
  margin-top: 26rpx;
  padding: 34rpx;
}

.price-card {
  display: block;
  width: 100%;
}

.price-tap-card {
  display: block;
  width: 100%;
  overflow: hidden;
  text-align: left;
  background:
    radial-gradient(circle at 92% 4%, rgba(0, 113, 227, .15), transparent 34%),
    linear-gradient(180deg, #ffffff, #f4f9ff);
}

.price-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
}

.price-title,
.price-sub,
.price-more,
.tariff-name,
.tariff-level {
  display: block;
}

.price-title {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 840;
  line-height: 1.12;
}

.price-sub {
  margin-top: 12rpx;
  max-width: 510rpx;
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.5;
}

.price-more {
  flex: 0 0 auto;
  margin-top: 20rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #0071e3;
  background: #edf6ff;
  font-size: 23rpx;
  font-weight: 780;
}

.block-label {
  display: block;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 760;
}

.tariff-strip {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 30rpx;
}

.tariff-pill {
  min-width: 0;
  padding: 26rpx 24rpx 24rpx;
  border-radius: 30rpx;
  color: #fff;
  background:
    radial-gradient(circle at 88% 0, rgba(0, 113, 227, .35), transparent 40%),
    linear-gradient(180deg, #151922, #0d0f14);
  box-shadow: 0 22rpx 48rpx rgba(0, 0, 0, .16);
}

.tariff-name {
  color: rgba(255, 255, 255, .62);
  font-size: 23rpx;
  font-weight: 760;
}

.tariff-value-line {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin-top: 16rpx;
}

.tariff-value {
  display: block;
  font-size: 54rpx;
  font-weight: 880;
  line-height: .95;
}

.tariff-unit {
  display: block;
  padding-bottom: 4rpx;
  color: rgba(255, 255, 255, .58);
  font-size: 18rpx;
  line-height: 1.2;
}

.tariff-level {
  margin-top: 16rpx;
  color: #8fc7ff;
  font-size: 22rpx;
  font-weight: 760;
}

.signal-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx 22rpx;
  margin-top: 30rpx;
  padding: 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, .72);
  border: 1rpx solid rgba(0, 0, 0, .05);
}

.price-row {
  min-width: 0;
}

.price-head {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  font-size: 26rpx;
  font-weight: 650;
}

.price-head text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-head text:last-child {
  flex: 0 0 auto;
  color: #3f4651;
}

.track {
  height: 9rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #e2e6ec;
}

.bar {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0071e3, #65bcff);
}

.learn-card {
  color: #fff;
  background: #111114;
}

.learn-card .block-label {
  color: rgba(255, 255, 255, .56);
}

.learn-title {
  display: block;
  margin-top: 24rpx;
  font-size: 46rpx;
  font-weight: 820;
}

.learn-copy {
  display: block;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, .74);
  font-size: 28rpx;
  line-height: 1.65;
}
