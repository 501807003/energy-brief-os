<view class="page home" wx:if="{{issue}}">
  <view class="topbar">
    <view>
      <text class="brand">新能源简报</text>
      <text class="date-line">{{issue.weekday}} {{issue.generated_at}}</text>
    </view>
    <button class="archive-link" bindtap="openArchive">历史</button>
  </view>

  <view class="hero">
    <view class="title">
      <text>每天早上</text>
      <text>读懂新能源</text>
    </view>
    <text class="summary">{{issue.daily_judgment}}</text>
  </view>

  <view class="focus-panel">
    <view class="panel-head">
      <text class="panel-kicker">今日路线</text>
      <text class="panel-title">先抓住 6 条线</text>
      <text class="panel-sub">左右滑动浏览，点开直接看原文。</text>
    </view>

    <scroll-view class="focus-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="focus-track">
        <button
          class="focus-card"
          wx:for="{{sections}}"
          wx:key="id"
          data-url="{{item.url}}"
          data-title="{{item.title}}"
          bindtap="openSource"
        >
          <view class="card-top">
            <view>
              <text class="card-index">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</text>
              <text class="card-label">{{item.label}}</text>
            </view>
            <text class="card-arrow">›</text>
          </view>
          <text class="card-title">{{item.title}}</text>
          <text class="card-desc">{{item.summary}}</text>
        </button>
      </view>
    </scroll-view>
  </view>

  <view class="price-card">
    <text class="block-label">价格观察</text>
    <view class="price-row" wx:for="{{priceWatch}}" wx:key="label">
      <view class="price-head">
        <text>{{item.label}}</text>
        <text>{{item.level}}</text>
      </view>
      <view class="track">
        <view class="bar" style="width: {{item.value}}%;"></view>
      </view>
    </view>
  </view>

  <view class="learn-card">
    <text class="block-label">今天只学一个概念</text>
    <text class="learn-title">{{issue.learning_card.term}}</text>
    <text class="learn-copy">{{issue.learning_card.plain_explanation}}</text>
    <text class="learn-copy">{{issue.learning_card.project_angle}}</text>
  </view>
</view>