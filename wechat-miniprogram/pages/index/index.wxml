<view class="page home" wx:if="{{issue}}">
  <view class="topbar">
    <text>&#26032;&#33021;&#28304;&#31616;&#25253;</text>
    <button bindtap="openArchive">&#24402;&#26723;</button>
  </view>

  <view class="hero">
    <text class="eyebrow">{{issue.weekday}} {{issue.generated_at}}</text>
    <view class="title">
      <text>&#27599;&#22825;&#26089;&#19978;</text>
      <text>&#35835;&#25026;&#26032;&#33021;&#28304;</text>
    </view>
    <text class="summary">{{issue.daily_judgment}}</text>
  </view>

  <view class="glass-panel">
    <view class="panel-head">
      <text class="panel-kicker">&#20170;&#26085;&#36335;&#32447;</text>
      <text class="panel-title">&#20808;&#25235;&#20303; 6 &#26465;&#32447;</text>
      <text class="panel-sub">&#28857;&#24320;&#19968;&#39033;&#65292;&#30452;&#25509;&#30475;&#21028;&#26029;&#12289;&#35201;&#28857;&#21644;&#21407;&#25991;&#38142;&#25509;&#12290;</text>
    </view>
    <view class="section-list">
      <button
        class="section-row"
        wx:for="{{sections}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-date="{{issue.date}}"
        bindtap="openSection"
      >
        <view class="row-index-wrap">
          <text class="row-index">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</text>
          <text class="row-label">{{item.label}}</text>
        </view>
        <view class="row-content">
          <text class="row-title">{{item.title}}</text>
          <text class="row-desc">{{item.summary}}</text>
        </view>
        <text class="row-arrow">&#8250;</text>
      </button>
    </view>
  </view>

  <view class="price-card">
    <text class="block-label">&#20215;&#26684;&#35266;&#23519;</text>
    <view class="price-row" wx:for="{{priceWatch}}" wx:key="label">
      <view class="price-head">
        <text>{{item.label}}</text>
        <text>{{item.level}}</text>
      </view>
      <view class="track">
        <view class="bar" style="width: {{item.value}}%;"></view>
      </view>
    </view>
  </view>

  <view class="learn-card">
    <text class="block-label">&#20170;&#22825;&#21482;&#23398;&#19968;&#20010;&#27010;&#24565;</text>
    <text class="learn-title">{{issue.learning_card.term}}</text>
    <text class="learn-copy">{{issue.learning_card.plain_explanation}}</text>
    <text class="learn-copy">{{issue.learning_card.project_angle}}</text>
  </view>
</view>
