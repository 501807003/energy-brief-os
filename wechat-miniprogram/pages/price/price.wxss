.price-page {
  padding-top: 36rpx;
}

.price-hero {
  padding: 18rpx 0 32rpx;
}

.kicker,
.title,
.copy {
  display: block;
}

.kicker {
  color: #0071e3;
  font-size: 25rpx;
  font-weight: 820;
}

.title {
  margin-top: 18rpx;
  font-size: 54rpx;
  font-weight: 860;
  line-height: 1.12;
}

.copy {
  margin-top: 20rpx;
  color: #6e6e73;
  font-size: 28rpx;
  line-height: 1.55;
}

.range-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin: 0 0 28rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #e9edf3;
}

.range-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  border-radius: 999rpx;
  color: #656b73;
  background: transparent;
  font-size: 25rpx;
  font-weight: 760;
}

.range-tab.active {
  color: #0071e3;
  background: #fff;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, .08);
}

.tariff-list {
  display: grid;
  gap: 26rpx;
}

.tariff-card {
  padding: 34rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #fff, #f8fafd);
  border: 1rpx solid rgba(0, 0, 0, .05);
  box-shadow: 0 26rpx 76rpx rgba(0, 0, 0, .08);
}

.tariff-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.tariff-label,
.tariff-dates,
.tariff-value text,
.tariff-change text,
.tariff-note {
  display: block;
}

.tariff-label {
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1.18;
}

.tariff-dates {
  margin-top: 12rpx;
  color: #8f8f95;
  font-size: 22rpx;
}

.tariff-value {
  flex: 0 0 168rpx;
  padding: 20rpx 18rpx;
  border-radius: 30rpx;
  color: #fff;
  background: #0f1218;
  text-align: center;
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, .18);
}

.tariff-value text:first-child {
  font-size: 46rpx;
  font-weight: 880;
  line-height: 1;
}

.tariff-value text:last-child {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, .62);
  font-size: 20rpx;
  line-height: 1.25;
}

.tariff-change {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 26rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: #f5f8fc;
  color: #3a4653;
  font-size: 24rpx;
  font-weight: 700;
}

.tariff-change text:last-child {
  max-width: 420rpx;
  color: #0071e3;
  text-align: right;
}

.tariff-chart {
  position: relative;
  display: flex;
  align-items: flex-end;
  gap: 28rpx;
  height: 300rpx;
  margin-top: 34rpx;
  padding: 0 8rpx 8rpx;
}

.axis-line {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 42rpx;
  height: 2rpx;
  background: #e4e7ec;
}

.axis-mid,
.axis-top {
  height: 1rpx;
  background: #edf0f4;
}

.axis-mid { bottom: 142rpx; }
.axis-top { bottom: 242rpx; }

.price-point {
  position: relative;
  z-index: 1;
  flex: 1;
  display: grid;
  align-items: end;
  justify-items: center;
  gap: 10rpx;
  height: 100%;
}

.point-value {
  color: #1d1d1f;
  font-size: 22rpx;
  font-weight: 760;
}

.point-marker {
  display: grid;
  justify-items: center;
  gap: 0;
}

.point-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 6rpx solid #0071e3;
  box-shadow: 0 8rpx 22rpx rgba(0, 113, 227, .24);
}

.point-column {
  width: 4rpx;
  min-height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #0071e3, rgba(0, 113, 227, .08));
}

.point-date {
  color: #8f8f95;
  font-size: 21rpx;
}

.tariff-note {
  margin-top: 22rpx;
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.55;
}
