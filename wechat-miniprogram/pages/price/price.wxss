.price-page {
  padding-top: 36rpx;
}

.price-hero {
  padding: 18rpx 0 32rpx;
}

.kicker,
.title,
.copy {
  display: block;
}

.kicker {
  color: #0071e3;
  font-size: 25rpx;
  font-weight: 820;
}

.title {
  margin-top: 18rpx;
  font-size: 54rpx;
  font-weight: 860;
  line-height: 1.12;
}

.copy {
  margin-top: 20rpx;
  color: #6e6e73;
  font-size: 28rpx;
  line-height: 1.55;
}

.range-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin: 0 0 28rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #e9edf3;
}

.range-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  border-radius: 999rpx;
  color: #656b73;
  background: transparent;
  font-size: 25rpx;
  font-weight: 760;
}

.range-tab.active {
  color: #0071e3;
  background: #fff;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, .08);
}

.tariff-list {
  display: grid;
  gap: 26rpx;
}

.tariff-card {
  padding: 34rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #fff, #f8fafd);
  border: 1rpx solid rgba(0, 0, 0, .05);
  box-shadow: 0 26rpx 76rpx rgba(0, 0, 0, .08);
}

.tariff-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.tariff-label,
.tariff-dates,
.tariff-value text,
.tariff-change text,
.tariff-note {
  display: block;
}

.tariff-label {
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1.18;
}

.tariff-dates {
  margin-top: 12rpx;
  color: #8f8f95;
  font-size: 22rpx;
}

.tariff-value {
  flex: 0 0 168rpx;
  padding: 20rpx 18rpx;
  border-radius: 30rpx;
  color: #fff;
  background: #0f1218;
  text-align: center;
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, .18);
}

.tariff-value text:first-child {
  font-size: 46rpx;
  font-weight: 880;
  line-height: 1;
}

.tariff-value text:last-child {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, .62);
  font-size: 20rpx;
  line-height: 1.25;
}

.tariff-change {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 26rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: #f5f8fc;
  color: #3a4653;
  font-size: 24rpx;
  font-weight: 700;
}

.tariff-change text:last-child {
  max-width: 420rpx;
  color: #0071e3;
  text-align: right;
}

.line-chart {
  position: relative;
  height: 300rpx;
  margin-top: 34rpx;
  overflow: hidden;
}

.axis-line {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 42rpx;
  height: 2rpx;
  background: #e4e7ec;
}

.axis-mid,
.axis-top {
  height: 1rpx;
  background: #edf0f4;
}

.axis-mid { bottom: 142rpx; }
.axis-top { bottom: 242rpx; }

.line-segment {
  position: absolute;
  z-index: 2;
  height: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0071e3, #53b9ff);
  box-shadow: 0 10rpx 24rpx rgba(0, 113, 227, .2);
  transform-origin: 0 50%;
}

.line-point {
  position: absolute;
  z-index: 3;
  width: 96rpx;
  height: 72rpx;
  margin-left: -48rpx;
  margin-bottom: -30rpx;
}

.point-dot {
  position: absolute;
  left: 33rpx;
  top: 27rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 6rpx solid #0071e3;
  box-shadow: 0 8rpx 22rpx rgba(0, 113, 227, .24);
}

.point-value {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  color: #1d1d1f;
  font-size: 22rpx;
  font-weight: 760;
  text-align: center;
}

.point-date {
  position: absolute;
  left: 0;
  right: 0;
  top: 50rpx;
  color: #8f8f95;
  font-size: 21rpx;
  text-align: center;
}

.tariff-note {
  margin-top: 22rpx;
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.55;
}

.risk-note {
  margin-top: 26rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #7b828c;
  font-size: 23rpx;
  line-height: 1.55;
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, .05);
}

.risk-note text {
  display: block;
}
