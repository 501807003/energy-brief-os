.archive {
  padding-top: 18rpx;
}

.archive-hero {
  padding: 30rpx 0 28rpx;
}

.eyebrow {
  display: block;
  color: #0071e3;
  font-size: 26rpx;
  font-weight: 760;
}

.title {
  display: block;
  margin-top: 18rpx;
  font-size: 50rpx;
  font-weight: 850;
  line-height: 1.1;
}

.hero-copy {
  display: block;
  margin-top: 24rpx;
  color: #6e6e73;
  font-size: 28rpx;
  line-height: 1.55;
}

.date-scroll {
  width: calc(100% + 64rpx);
  margin-left: -32rpx;
  margin-bottom: 26rpx;
  white-space: nowrap;
}

.date-track {
  display: inline-flex;
  gap: 14rpx;
  padding: 2rpx 32rpx 8rpx;
}

.date-pill {
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 132rpx;
  min-height: 138rpx;
  padding: 18rpx 16rpx;
  border-radius: 30rpx;
  color: #6e6e73;
  background: rgba(255, 255, 255, .78);
  text-align: left;
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, .04);
}

.date-pill.active {
  color: #fff;
  background: #1d1d1f;
  box-shadow: 0 22rpx 50rpx rgba(0, 0, 0, .18);
}

.date-pill text:first-child {
  font-size: 22rpx;
  font-weight: 700;
}

.date-pill text:nth-child(2) {
  margin-top: 6rpx;
  font-size: 44rpx;
  font-weight: 860;
  line-height: 1;
}

.date-pill text:last-child {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 720;
}

.issue-shell {
  width: 100%;
  padding: 34rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, .98), rgba(246, 250, 255, .96));
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, .075);
}

.issue-date,
.row-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.date,
.headline,
.weekday {
  display: block;
}

.date {
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1.1;
  letter-spacing: 0;
}

.headline {
  margin-top: 28rpx;
  color: #33363d;
  font-size: 28rpx;
  line-height: 1.55;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.weekday {
  margin-top: 10rpx;
  color: #0071e3;
  font-size: 25rpx;
  font-weight: 760;
}

.enter {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 154rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #0071e3;
  background: #eaf3ff;
  font-size: 24rpx;
  font-weight: 760;
}

.enter text:last-child {
  font-size: 34rpx;
  line-height: 1;
}

.preview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 30rpx;
}

.preview-chip {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  min-height: 62rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  color: #1d1d1f;
  background: rgba(255, 255, 255, .82);
  border: 1rpx solid rgba(0, 0, 0, .055);
  font-size: 23rpx;
  font-weight: 700;
}

.preview-chip text:first-child {
  color: #0071e3;
  font-size: 21rpx;
  font-weight: 850;
}

.row-foot {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, .07);
  color: #6e6e73;
  font-size: 23rpx;
  font-weight: 650;
}

.row-foot text:last-child {
  color: #0071e3;
}
