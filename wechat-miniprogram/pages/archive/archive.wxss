.archive {
  padding-top: 24rpx;
}

.archive-hero {
  padding: 36rpx 0 34rpx;
}

.eyebrow {
  display: block;
  color: #0071e3;
  font-size: 26rpx;
  font-weight: 760;
}

.title {
  display: block;
  margin-top: 18rpx;
  font-size: 52rpx;
  font-weight: 850;
  line-height: 1.1;
}

.hero-copy {
  display: block;
  margin-top: 24rpx;
  color: #6e6e73;
  font-size: 28rpx;
  line-height: 1.55;
}

.archive-list {
  display: grid;
  width: 100%;
  gap: 24rpx;
}

.archive-row {
  display: block;
  width: 100%;
  min-height: 0;
  padding: 34rpx;
  border-radius: 36rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, .98), rgba(246, 250, 255, .96));
  text-align: left;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, .075);
}

.row-head,
.row-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.date,
.headline,
.weekday {
  display: block;
}

.date {
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1.1;
  letter-spacing: 0;
}

.headline {
  margin-top: 28rpx;
  color: #33363d;
  font-size: 28rpx;
  line-height: 1.55;
}

.weekday {
  margin-top: 10rpx;
  color: #0071e3;
  font-size: 25rpx;
  font-weight: 760;
}

.enter {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 154rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #0071e3;
  background: #eaf3ff;
  font-size: 24rpx;
  font-weight: 760;
}

.enter text:last-child {
  font-size: 34rpx;
  line-height: 1;
}

.preview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 30rpx;
}

.preview-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 56rpx;
  border-radius: 18rpx;
  color: #1d1d1f;
  background: rgba(255, 255, 255, .82);
  border: 1rpx solid rgba(0, 0, 0, .055);
  font-size: 23rpx;
  font-weight: 700;
}

.preview-chip text:first-child {
  color: #0071e3;
  font-size: 21rpx;
  font-weight: 850;
}

.row-foot {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, .07);
  color: #6e6e73;
  font-size: 23rpx;
  font-weight: 650;
}

.row-foot text:last-child {
  color: #0071e3;
}
