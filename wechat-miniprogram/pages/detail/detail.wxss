.detail {
  padding-top: 32rpx;
}

.detail-hero {
  padding: 52rpx 0 30rpx;
}

.issue-hero {
  padding: 44rpx 0 30rpx;
}

.rank {
  display: block;
  color: #0071e3;
  font-size: 30rpx;
  font-weight: 850;
}

.meta {
  display: block;
  margin-top: 12rpx;
  color: #6e6e73;
  font-size: 26rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-top: 42rpx;
  font-size: 64rpx;
  font-weight: 860;
  line-height: 1.08;
}

.summary {
  display: block;
  margin-top: 28rpx;
  color: #33363d;
  font-size: 32rpx;
  line-height: 1.62;
}

.reason-card,
.source-card {
  margin-top: 28rpx;
  padding: 36rpx;
  border-radius: 38rpx;
  background: #fff;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, .07);
}

.issue-section-list {
  display: grid;
  gap: 24rpx;
}

.issue-section-card {
  display: block;
  width: 100%;
  padding: 34rpx;
  border-radius: 34rpx;
  background: #fff;
  text-align: left;
  box-shadow: 0 22rpx 64rpx rgba(0, 0, 0, .065);
}

.issue-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.issue-index,
.issue-label,
.issue-title,
.issue-summary {
  display: block;
}

.issue-index {
  color: #0071e3;
  font-size: 25rpx;
  font-weight: 850;
}

.issue-label {
  margin-top: 8rpx;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 720;
}

.issue-arrow {
  color: #0071e3;
  font-size: 46rpx;
  font-weight: 650;
  line-height: 1;
}

.issue-title {
  margin-top: 26rpx;
  font-size: 34rpx;
  font-weight: 820;
  line-height: 1.25;
}

.issue-summary {
  margin-top: 18rpx;
  color: #33363d;
  font-size: 28rpx;
  line-height: 1.58;
}

.source-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(0, 0, 0, .07);
  color: #6e6e73;
  font-size: 23rpx;
  font-weight: 650;
}

.source-inline text:last-child {
  flex: 0 0 auto;
  color: #0071e3;
}

.label {
  display: block;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 760;
}

.reason {
  display: block;
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.65;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 28rpx;
}

.tag {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  color: #006edb;
  background: #eaf3ff;
  font-size: 24rpx;
  font-weight: 650;
}

.source-name {
  display: block;
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 760;
}

.source-url {
  display: block;
  margin-top: 16rpx;
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.copy-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 30rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #0071e3;
  font-size: 30rpx;
  font-weight: 760;
  box-shadow: 0 20rpx 38rpx rgba(0, 113, 227, .24);
}

.watch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, .06);
  font-size: 28rpx;
}

.watch-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.watch-row text:first-child {
  color: #33363d;
  font-weight: 700;
}

.watch-row text:last-child {
  color: #0071e3;
  font-weight: 760;
}

.learn-term,
.learn-extra {
  display: block;
}

.learn-term {
  margin-top: 22rpx;
  font-size: 36rpx;
  font-weight: 840;
}

.learn-extra {
  margin-top: 18rpx;
  color: #6e6e73;
  font-size: 28rpx;
  line-height: 1.55;
}
