.detail {
  padding-top: 32rpx;
}

.detail-hero {
  padding: 52rpx 0 30rpx;
}

.rank {
  display: block;
  color: #0071e3;
  font-size: 30rpx;
  font-weight: 850;
}

.meta {
  display: block;
  margin-top: 12rpx;
  color: #6e6e73;
  font-size: 26rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-top: 42rpx;
  font-size: 64rpx;
  font-weight: 860;
  line-height: 1.08;
}

.summary {
  display: block;
  margin-top: 28rpx;
  color: #33363d;
  font-size: 32rpx;
  line-height: 1.62;
}

.reason-card,
.source-card {
  margin-top: 28rpx;
  padding: 36rpx;
  border-radius: 38rpx;
  background: #fff;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, .07);
}

.label {
  display: block;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 760;
}

.reason {
  display: block;
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.65;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 28rpx;
}

.tag {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  color: #006edb;
  background: #eaf3ff;
  font-size: 24rpx;
  font-weight: 650;
}

.source-name {
  display: block;
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 760;
}

.source-url {
  display: block;
  margin-top: 16rpx;
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.copy-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 30rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #0071e3;
  font-size: 30rpx;
  font-weight: 760;
  box-shadow: 0 20rpx 38rpx rgba(0, 113, 227, .24);
}
