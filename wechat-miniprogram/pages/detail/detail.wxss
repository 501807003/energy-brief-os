.detail {
  padding-top: 32rpx;
}

.detail-hero {
  padding: 52rpx 0 30rpx;
}

.issue-hero {
  padding: 44rpx 0 30rpx;
}

.rank {
  display: block;
  color: #0071e3;
  font-size: 30rpx;
  font-weight: 850;
}

.meta {
  display: block;
  margin-top: 12rpx;
  color: #6e6e73;
  font-size: 26rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-top: 42rpx;
  font-size: 64rpx;
  font-weight: 860;
  line-height: 1.08;
}

.summary {
  display: block;
  margin-top: 28rpx;
  color: #33363d;
  font-size: 32rpx;
  line-height: 1.62;
}

.reason-card,
.source-card {
  margin-top: 28rpx;
  padding: 36rpx;
  border-radius: 38rpx;
  background: #fff;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, .07);
}

.issue-section-list {
  display: grid;
  gap: 0;
  margin-top: 8rpx;
  border-top: 1rpx solid rgba(0, 0, 0, .08);
}

.issue-section-card {
  position: relative;
  display: block;
  width: 100%;
  padding: 34rpx 0 34rpx 78rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, .08);
  border-radius: 0;
  background: transparent;
  text-align: left;
  box-shadow: none;
}

.issue-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.issue-section-card::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 40rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #0071e3;
  box-shadow: 0 0 0 12rpx #eaf3ff;
}

.issue-section-card::after {
  content: "";
  position: absolute;
  left: 32rpx;
  top: 76rpx;
  bottom: -18rpx;
  width: 2rpx;
  background: rgba(0, 113, 227, .16);
}

.issue-section-card:last-child::after {
  display: none;
}

.issue-section-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.issue-index,
.issue-label,
.issue-title,
.issue-summary {
  display: block;
}

.issue-index {
  color: #0071e3;
  font-size: 24rpx;
  font-weight: 850;
}

.issue-label {
  margin-top: 0;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  color: #6e6e73;
  background: rgba(255, 255, 255, .82);
  font-size: 23rpx;
  font-weight: 720;
}

.issue-arrow {
  color: #0071e3;
  font-size: 46rpx;
  font-weight: 650;
  line-height: 1;
}

.issue-title {
  margin-top: 18rpx;
  font-size: 36rpx;
  font-weight: 820;
  line-height: 1.22;
}

.issue-summary {
  margin-top: 16rpx;
  color: #33363d;
  font-size: 29rpx;
  line-height: 1.55;
}

.source-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
  color: #6e6e73;
  font-size: 23rpx;
  font-weight: 650;
}

.source-inline text:last-child {
  flex: 0 0 auto;
  color: #0071e3;
}

.label {
  display: block;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 760;
}

.reason {
  display: block;
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.65;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 28rpx;
}

.tag {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  color: #006edb;
  background: #eaf3ff;
  font-size: 24rpx;
  font-weight: 650;
}

.compact-tags {
  max-height: 58rpx;
  overflow: hidden;
}

.source-name {
  display: block;
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 760;
}

.source-url {
  display: block;
  margin-top: 16rpx;
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.copy-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 30rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #0071e3;
  font-size: 30rpx;
  font-weight: 760;
  box-shadow: 0 20rpx 38rpx rgba(0, 113, 227, .24);
}

.watch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, .06);
  font-size: 28rpx;
}

.watch-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.watch-row text:first-child {
  color: #33363d;
  font-weight: 700;
}

.watch-row text:last-child {
  color: #0071e3;
  font-weight: 760;
}

.learn-term,
.learn-extra {
  display: block;
}

.learn-term {
  margin-top: 22rpx;
  font-size: 36rpx;
  font-weight: 840;
}

.learn-extra {
  margin-top: 18rpx;
  color: #6e6e73;
  font-size: 28rpx;
  line-height: 1.55;
}
